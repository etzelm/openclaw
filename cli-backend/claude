#!/usr/bin/env node
// Synthetic stand-in for the Claude Code executable: speaks just enough stream-json to complete a turn.
const fs = require("fs");
const args = process.argv.slice(2);
if (args.includes("--version")) { console.log("2.1.226 (Claude Code)"); process.exit(0); }
const idx = (f) => args.indexOf(f);
const resume = idx("--resume") >= 0 ? args[idx("--resume") + 1] : undefined;
const created = idx("--session-id") >= 0 ? args[idx("--session-id") + 1] : undefined;
const sessionId = resume ?? created ?? "stub-session";
const log = (o) => fs.appendFileSync(process.env.STUB_LOG, JSON.stringify({ pid: process.pid, ...o }) + "\n");
log({ ev: "spawn", cwd: process.cwd(), mode: resume ? "resume" : "new-session", sessionId, argvHead: args.filter((a) => /^--(resume|session-id|model)$/.test(a) ? true : false) });
let buf = "", turns = 0;
process.stdin.on("data", (d) => {
  buf += d;
  let i;
  while ((i = buf.indexOf("\n")) >= 0) {
    const line = buf.slice(0, i); buf = buf.slice(i + 1);
    if (!line.trim()) continue;
    let m; try { m = JSON.parse(line); } catch { continue; }
    if (m.type === "control_request") {
      log({ ev: "control", subtype: m.request && m.request.subtype });
      process.stdout.write(JSON.stringify({ type: "control_response", response: { subtype: "success", request_id: m.request_id, response: {} } }) + "\n");
      continue;
    }
    if (m.type !== "user") continue;
    turns++;
    const text = JSON.stringify(m.message ?? m).match(/turn-[a-z0-9-]+/)?.[0] ?? "unknown";
    log({ ev: "turn", cwd: process.cwd(), sessionId, prompt: text, turnsInProcess: turns });
    const out = (o) => process.stdout.write(JSON.stringify(o) + "\n");
    out({ type: "system", subtype: "init", session_id: sessionId, cwd: process.cwd(), tools: [], model: "stub" });
    out({ type: "result", subtype: "success", session_id: sessionId, result: `STUB-REPLY cwd=${process.cwd()} session=${sessionId}`, is_error: false, duration_ms: 5, num_turns: turns });
  }
});
process.stdin.on("end", () => process.exit(0));
