From d27f9cb3eb7fb0011baf4d26610a2a4ca59fe8a1 Mon Sep 17 00:00:00 2001
From: Mitchell Etzel <etzelm@users.noreply.github.com>
Date: Fri, 16 Oct 2026 20:44:38 -0700
Subject: [PATCH] improve(memory): faster memory index admission on large
 full-text indexes

The FTS row-count check in reconcileMemoryChunkFtsRows ran COUNT(*) on
the FTS5 virtual table, which FTS5 serves as a full scan of %_content.
Count the %_docsize shadow table instead: the admitted body FTS DDL keeps
the default columnsize=1, so it holds exactly one row per document and
returns the same number from a much smaller table. The rebuild decision,
force handling and rebuild SQL are unchanged.
---
 .../host/memory-schema-fts-reconcile.test.ts  | 56 ++++++++++++++++++-
 .../database-engine/sqlite-search-schema.ts   |  4 +-
 2 files changed, 58 insertions(+), 2 deletions(-)

diff --git a/packages/memory-host-sdk/src/host/memory-schema-fts-reconcile.test.ts b/packages/memory-host-sdk/src/host/memory-schema-fts-reconcile.test.ts
index b024ccaa7cf..c11bc419382 100644
--- a/packages/memory-host-sdk/src/host/memory-schema-fts-reconcile.test.ts
+++ b/packages/memory-host-sdk/src/host/memory-schema-fts-reconcile.test.ts
@@ -1,6 +1,6 @@
 // Memory FTS reconciliation keeps derived schemas aligned with canonical data.
 import { DatabaseSync } from "node:sqlite";
-import { describe, expect, it } from "vitest";
+import { describe, expect, it, vi } from "vitest";
 import { ensureMemoryIndexSchema } from "./memory-schema.js";
 
 describe("memory FTS schema reconciliation", () => {
@@ -79,6 +79,60 @@ describe("memory FTS schema reconciliation", () => {
     }
   });
 
+  it("counts derived rows from the FTS5 docsize table, not by scanning the FTS table", () => {
+    const db = new DatabaseSync(":memory:");
+    try {
+      expect(
+        ensureMemoryIndexSchema({ db, cacheEnabled: false, ftsEnabled: true }).ftsAvailable,
+      ).toBe(true);
+      const insert = db.prepare(
+        `INSERT INTO memory_index_chunks
+           (id, path, source, start_line, end_line, hash, model, text, embedding, updated_at)
+         VALUES (?, 'memory/seed.md', 'memory', 1, 1, ?, 'model', ?, X'', 1)`,
+      );
+      // Deletes, re-inserts and empty-text rows move %_docsize alongside the FTS content rows.
+      for (let i = 0; i < 40; i++) {
+        insert.run(`chunk-${i}`, `hash-${i}`, i % 10 === 0 ? "" : `seed body ${i}`);
+      }
+      db.exec("DELETE FROM memory_index_chunks WHERE CAST(substr(id, 7) AS INTEGER) % 3 = 0");
+      for (const i of [3, 6, 9]) {
+        insert.run(`chunk-${i}`, `rehash-${i}`, `reinserted body ${i}`);
+      }
+      db.exec("UPDATE memory_index_chunks SET text = 'edited body' WHERE id = 'chunk-1'");
+
+      const prepare = vi.spyOn(db, "prepare");
+      let preparedSql: string[] = [];
+      try {
+        expect(
+          ensureMemoryIndexSchema({ db, cacheEnabled: false, ftsEnabled: true }).ftsAvailable,
+        ).toBe(true);
+        preparedSql = prepare.mock.calls.map(([sql]) => sql);
+      } finally {
+        prepare.mockRestore();
+      }
+      const countSql = preparedSql.find((sql) => sql.includes("derived_count"));
+      expect(countSql).toBeDefined();
+      const plan = db
+        .prepare(`EXPLAIN QUERY PLAN ${countSql}`)
+        .all()
+        .map((row) => String(row.detail));
+      expect(plan.filter((detail) => detail.includes("VIRTUAL TABLE"))).toEqual([]);
+      expect(plan.join("\n")).toContain("memory_index_chunks_fts_docsize");
+
+      const counts = db.prepare(String(countSql)).get() as {
+        canonical_count: number;
+        derived_count: number;
+      };
+      const ftsCount = db.prepare("SELECT COUNT(*) AS n FROM memory_index_chunks_fts").get() as {
+        n: number;
+      };
+      expect(counts).toEqual({ canonical_count: 29, derived_count: ftsCount.n });
+      expect(ftsCount.n).toBe(29);
+    } finally {
+      db.close();
+    }
+  });
+
   it("rebuilds body and path indexes when their tokenizer changes", () => {
     const db = new DatabaseSync(":memory:");
     try {
diff --git a/src/infra/database-engine/sqlite-search-schema.ts b/src/infra/database-engine/sqlite-search-schema.ts
index 1a6a0835e7f..8906343f2e5 100644
--- a/src/infra/database-engine/sqlite-search-schema.ts
+++ b/src/infra/database-engine/sqlite-search-schema.ts
@@ -168,11 +168,13 @@ export function reconcileMemoryChunkFtsRows(
   ftsTable: string,
   force = false,
 ): void {
+  // Admitted body FTS DDL keeps the default columnsize=1, so FTS5 stores one %_docsize row per
+  // document; counting it returns COUNT(*) of the FTS table without a full scan of %_content.
   const rowCounts = db
     .prepare(
       `SELECT
          (SELECT COUNT(*) FROM ${MEMORY_INDEX_CHUNKS_TABLE}) AS canonical_count,
-         (SELECT COUNT(*) FROM ${ftsTable}) AS derived_count`,
+         (SELECT COUNT(*) FROM ${ftsTable}_docsize) AS derived_count`,
     )
     // SAFETY: both scalar aggregate subqueries always return their named numeric columns.
     .get() as { canonical_count: number; derived_count: number };
