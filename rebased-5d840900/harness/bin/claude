#!/usr/bin/env node
// Synthetic Claude Code child for the native-login history harness. It speaks the stream-json
// control protocol, records what crossed its stdin, and can rewrite the login on disk at
// chosen moments to model reassignment or revocation while a run is in flight.
import fs from "node:fs";
import crypto from "node:crypto";
import readline from "node:readline";
import path from "node:path";
import { execSync } from "node:child_process";

if (process.argv.includes("--version")) {
  console.log("2.1.290 (Claude Code)");
  process.exit(0);
}
const log = process.env.FAKE_CLAUDE_LOG;
// The login this child would be running under right now, read the way Claude reads it.
const loginNow = () => {
  const configDir = process.env.CLAUDE_CONFIG_DIR;
  const account = configDir
    ? path.join(configDir, ".claude.json")
    : path.join(process.env.HOME ?? "", ".claude.json");
  const credential = configDir
    ? path.join(configDir, ".credentials.json")
    : path.join(process.env.HOME ?? "", ".claude", ".credentials.json");
  let uuid = null;
  try {
    uuid = JSON.parse(fs.readFileSync(account, "utf8")).oauthAccount.accountUuid;
  } catch {}
  // The account the credential itself belongs to: synthetic tokens are "synthetic-<account>[~n]".
  let credentialAccount = null;
  try {
    const token = JSON.parse(fs.readFileSync(credential, "utf8")).claudeAiOauth.accessToken;
    credentialAccount = String(token).replace(/^synthetic-/, "").replace(/~\d+$/, "");
  } catch {}
  return {
    loginAccount: uuid,
    credentialAccount,
    loginCredentialPresent: fs.existsSync(credential),
  };
};
const record = (event, extra = {}) => {
  if (log) {
    fs.appendFileSync(
      log,
      JSON.stringify({
        at: new Date().toISOString(),
        pid: process.pid,
        event,
        configDir: process.env.CLAUDE_CONFIG_DIR ?? null,
        ...loginNow(),
        ...extra,
      }) + "\n",
    );
  }
};
const hook = (name) => {
  const command = process.env[name];
  if (command) {
    execSync(command, { stdio: "ignore" });
    record("hook-ran", { hook: name });
  }
};
const send = (value) => process.stdout.write(JSON.stringify(value) + "\n");
// The Claude session id OpenClaw asked for: --session-id on a fresh session, --resume on a resumed one.
const argValue = (flag) => {
  const index = process.argv.indexOf(flag);
  return index >= 0 ? process.argv[index + 1] : undefined;
};
const resumed = argValue("--resume");
const sessionId = resumed ?? argValue("--session-id") ?? crypto.randomUUID();
// FAKE_WRITE_TRANSCRIPT=1 writes a native transcript where Claude keeps it, so OpenClaw can resume
// the session on the next turn. Without it every turn starts a fresh Claude session.
const writeTranscript = (content) => {
  if (process.env.FAKE_WRITE_TRANSCRIPT !== "1") {
    return;
  }
  let cwd = process.cwd();
  try {
    cwd = fs.realpathSync.native(cwd).normalize("NFC");
  } catch {}
  const dir = path.join(process.env.HOME ?? "", ".claude", "projects", cwd.replace(/[^a-zA-Z0-9]/g, "-"));
  fs.mkdirSync(dir, { recursive: true });
  const lines = [
    { type: "user", sessionId, message: { role: "user", content } },
    { type: "assistant", sessionId, message: { role: "assistant", content: [{ type: "text", text: process.env.FAKE_REPLY ?? "STORED" }] } },
  ];
  fs.appendFileSync(path.join(dir, `${sessionId}.jsonl`), lines.map((l) => JSON.stringify(l)).join("\n") + "\n");
};
// The system prompt arrives in argv (or a file named there). Keep it, so a run can show which
// saved context reached this child before any user message.
let argvFile;
if (log && process.argv.length > 4) {
  const parts = process.argv.slice(2).map((arg) => {
    try {
      return arg.length < 4096 && fs.statSync(arg).isFile() ? `${arg}\n${fs.readFileSync(arg, "utf8")}` : arg;
    } catch {
      return arg;
    }
  });
  argvFile = `${log}.argv-${process.pid}.txt`;
  fs.writeFileSync(argvFile, parts.join("\n"));
}
record("spawn", { argc: process.argv.length - 2, sessionMode: resumed ? "resume" : "fresh", ...(argvFile ? { argvFile } : {}) });
let userMessages = 0;
let promptHook = false;
const pendingHooks = new Map();
// After the prompt (and its UserPromptSubmit hook, when registered) the child replies.
const finishUserTurn = (content) => {
  hook("FAKE_ON_USER");
  writeTranscript(content);
  send({
    type: "result",
    subtype: "success",
    is_error: false,
    result: process.env.FAKE_REPLY ?? "STORED",
    session_id: sessionId,
  });
};
for await (const line of readline.createInterface({ input: process.stdin })) {
  const message = JSON.parse(line);
  if (message.type === "control_response" && pendingHooks.has(message.response?.request_id)) {
    // Claude CLI asks the SDK host for UserPromptSubmit additional context before it handles the
    // prompt; OpenClaw's private turn context (saved notes, interrupted inputs) arrives here.
    const { content, n } = pendingHooks.get(message.response.request_id);
    pendingHooks.delete(message.response.request_id);
    const extra = message.response?.response?.hookSpecificOutput?.additionalContext ?? "";
    const file = `${process.env.FAKE_CLAUDE_LOG}.context-${process.pid}-${n}.txt`;
    fs.writeFileSync(file, String(extra));
    record("prompt-context-received", {
      chars: String(extra).length,
      sha256: crypto.createHash("sha256").update(String(extra)).digest("hex"),
      contextFile: file,
    });
    finishUserTurn(content);
    continue;
  }
  if (message.type === "control_request" && message.request.subtype === "initialize") {
    promptHook = Boolean(message.request.hooks?.UserPromptSubmit);
    // The system prompt and appended context arrive in this request; keep it for canary counts.
    const initFile = log ? `${log}.init-${process.pid}.json` : undefined;
    if (initFile) {
      fs.writeFileSync(initFile, JSON.stringify(message.request, null, 1));
    }
    record("initialize", initFile ? { initFile } : {});
    hook("FAKE_ON_INIT");
    send({
      type: "control_response",
      response: {
        subtype: "success",
        request_id: message.request_id,
        response: { commands: [], models: [] },
      },
    });
  } else if (message.type === "user") {
    userMessages += 1;
    const content = String(message.message.content);
    const file = `${process.env.FAKE_CLAUDE_LOG}.user-${process.pid}-${userMessages}.txt`;
    fs.writeFileSync(file, content);
    record("user-message-received", {
      chars: content.length,
      sha256: crypto.createHash("sha256").update(content).digest("hex"),
      promptFile: file,
    });
    if (promptHook) {
      const requestId = `hook-${process.pid}-${userMessages}`;
      pendingHooks.set(requestId, { content, n: userMessages });
      send({
        type: "control_request",
        request_id: requestId,
        request: {
          subtype: "hook_callback",
          callback_id: "UserPromptSubmit",
          input: { hook_event_name: "UserPromptSubmit", prompt: content, session_id: sessionId },
        },
      });
    } else {
      finishUserTurn(content);
    }
  }
}
