+#if os(macOS) || os(iOS)
+import Foundation
+import Synchronization
+import Testing
+@testable import OpenClawKit
+
+/// Proof-only, not part of the fix. Drives the shipped GatewayChannelActor over a real URLSession
+/// WebSocket with its real timers (15 s keepalive, 10 s pong deadline, 30 s Gateway ticks).
+/// The fixture Gateway ticks normally, then goes silent 35 s after hello: it keeps reading,
+/// records every ping, and answers nothing. No network path change is emitted.
+struct KeepaliveMissNativeProofTests {
+    private final class Events: Sendable {
+        let lines = Mutex<[String]>([])
+        let start = Date()
+
+        func record(_ line: String) {
+            let elapsed = String(format: "%7.2f", Date().timeIntervalSince(self.start))
+            self.lines.withLock { $0.append("t=\(elapsed)s \(line)") }
+        }
+
+        func offset(_ date: Date) -> String {
+            String(format: "%.2f", date.timeIntervalSince(self.start))
+        }
+    }
+
+    @Test
+    func `silent Gateway socket with no path change is retired and replaced`() async throws {
+        let fixture = try await NativeGatewayWebSocketFixture.start(issuedDeviceTokens: [nil, nil])
+        defer { fixture.stop() }
+        let events = Events()
+        let snapshots = AsyncStream<UInt64>.makeStream()
+        var connections = snapshots.stream.makeAsyncIterator()
+        let channel = GatewayChannelActor(
+            url: fixture.url(),
+            token: nil,
+            pushHandler: { push, generation in
+                if case .snapshot = push {
+                    events.record("hello snapshot generation=\(generation)")
+                    snapshots.continuation.yield(generation)
+                }
+            },
+            connectOptions: GatewayConnectOptions(
+                role: "node", scopes: [], caps: [], commands: [], permissions: [:],
+                clientId: "keepalive-miss-proof", clientMode: "node", clientDisplayName: "Keepalive Proof",
+                includeDeviceIdentity: false),
+            disconnectHandler: { reason, generation in
+                events.record("disconnect generation=\(generation) reason=\(reason)")
+            },
+            // No path updates at all: the network path probe cannot be the detector.
+            networkPathUpdates: nil)
+        defer { snapshots.continuation.finish() }
+
+        try await channel.connect()
+        let first = try #require(await connections.next())
+        try await Task.sleep(for: .seconds(35))
+        fixture.silenceConnection(at: 0)
+        events.record("fixture connection 0 silent (no pongs, no ticks, no frames)")
+
+        let deadline = Task {
+            try? await Task.sleep(for: .seconds(180))
+            snapshots.continuation.finish()
+        }
+        let second = await connections.next()
+        deadline.cancel()
+        let pings = fixture.unansweredPings(at: 0).map(events.offset)
+        let replacementAuth = fixture.capturedAuth(at: 1) != nil
+        await channel.shutdown()
+
+        for line in events.lines.withLock({ $0 }) {
+            print("KEEPALIVE_PROOF \(line)")
+        }
+        print("KEEPALIVE_PROOF unanswered pings on connection 0 at t=\(pings.joined(separator: ", "))s")
+        print(
+            "KEEPALIVE_PROOF first generation=\(first)",
+            "replacement generation=\(second.map(String.init) ?? "none within 180 s")",
+            "replacement connect frame decoded=\(replacementAuth)")
+        #expect(second != nil)
+        #expect(second != first)
+        #expect(replacementAuth)
+    }
+}
+#endif
