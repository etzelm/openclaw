+import Foundation
+import OpenClawKit
+import OpenClawProtocol
+import Testing
+@testable import OpenClaw
+@testable import OpenClawChatUI
+
+/// Proof-only, not part of the fix. The app's IOSGatewayChatTransport and IOSSourceResourceLoader
+/// drive OpenClawChatViewModel through GatewayNodeSession over a real URLSession WebSocket to a local
+/// Gateway fixture that answers each chat.history after 1.5 s. The socket drops, health goes false then
+/// true, and the socket drops again; each reconnect raises the seqGap the app sees on a flapping link.
+struct IOSReconnectBurstWireProofTests {
+    @Test @MainActor func `flapping socket keeps catalog reads behind the transcript read`() async throws {
+        let fixture = try await NativeGatewayWebSocketFixture.start(issuedDeviceTokens: [])
+        defer { fixture.stop() }
+        fixture.acceptedOperatorScopes = ["operator.read", "operator.write"]
+        fixture.serveChat(
+            historyDelay: 1.5,
+            methods: [
+                "chat.history", "health", "models.list", "chat.metadata", "question.list", "progressCard.get",
+                "config.get", "skills.status", "tools.effective", "sessions.patch",
+            ],
+            capabilities: [GatewayServerCapability.publishedModelCatalog.rawValue])
+        let url = fixture.url()
+        var options = GatewayWebSocketTestSupport.identityFreeOperatorConnectOptions
+        options.allowStoredDeviceAuth = false
+        options.deviceAuthGatewayID = "reconnect-burst-proof"
+        let config = GatewayConnectConfig(
+            url: url,
+            stableID: "reconnect-burst-proof",
+            token: nil,
+            bootstrapToken: nil,
+            password: nil,
+            nodeOptions: options)
+        let gateway = GatewayNodeSession()
+        let sourceLoader = IOSSourceResourceLoader(gateway: gateway, connectionProvider: {
+            IOSMediaArtifactLoader.Connection(config: config, gatewayID: "reconnect-burst-proof", customHeaders: [:])
+        })
+        try await gateway.connect(
+            url: url,
+            credentials: .init(),
+            connectOptions: options,
+            sessionBox: nil,
+            onConnected: {},
+            onDisconnected: { _ in },
+            onInvoke: { BridgeInvokeResponse(id: $0.id, ok: true) })
+        let transport = IOSGatewayChatTransport(gateway: gateway, sourceResourceLoader: sourceLoader)
+        let vm = OpenClawChatViewModel(sessionKey: "main", transport: transport)
+        defer { vm.detachTransport() }
+        _ = await vm.refreshHistoryAfterRun()
+        await vm.pollHealthIfNeeded(force: true)
+        try await Task.sleep(for: .milliseconds(500))
+        fixture.resetWire()
+
+        func waitFor(_ condition: () -> Bool) async throws {
+            for _ in 0..<300 where !condition() {
+                try await Task.sleep(for: .milliseconds(20))
+            }
+        }
+        func historyRequested(after connection: Int) -> Bool {
+            fixture.wireTrace.contains { $0.connection > connection && $0.entry == "-> chat.history" }
+        }
+
+        let first = try #require(fixture.latestOpenConnection)
+        fixture.closeConnection(at: first)
+        try await waitFor { historyRequested(after: first) }
+        let second = try #require(fixture.latestOpenConnection)
+        fixture.pushEvent("health", payload: ["ok": false], at: second)
+        try await Task.sleep(for: .milliseconds(100))
+        fixture.pushEvent("health", payload: ["ok": true], at: second)
+        try await Task.sleep(for: .milliseconds(200))
+        fixture.closeConnection(at: second)
+        try await waitFor { historyRequested(after: second) }
+        // Let the last held history answer and every follow-up read settle.
+        try await Task.sleep(for: .seconds(4))
+        await gateway.disconnect()
+
+        let trace = fixture.wireTrace
+        var lines = trace.map { "RECONNECT_WIRE +\($0.ms)ms conn\($0.connection) \($0.entry)" }
+        let catalogMethods: Set = [
+            "models.list", "chat.metadata", "question.list", "config.get", "skills.status", "tools.effective",
+        ]
+        func isCatalogRead(_ entry: String) -> Bool {
+            entry.hasPrefix("-> ") && catalogMethods.contains(String(entry.dropFirst(3)))
+        }
+        let firstHistoryAnswer = trace.firstIndex { $0.entry == "<- chat.history" } ?? trace.endIndex
+        let earlyReads = trace[..<firstHistoryAnswer].map(\.entry).filter(isCatalogRead)
+        let mostRepeatedEarlyRead = Dictionary(grouping: earlyReads, by: { $0 }).values.map(\.count).max() ?? 0
+        let connections = Set(trace.map(\.connection)).sorted()
+        lines.append([
+            "RECONNECT_WIRE_SUMMARY connections=\(connections)",
+            "catalogRequests=\(trace.map(\.entry).filter(isCatalogRead).count)",
+            "catalogRequestsBeforeFirstHistoryAnswer=\(earlyReads.count)",
+            "mostRepeatedCatalogReadBeforeFirstHistoryAnswer=\(mostRepeatedEarlyRead)",
+            "historyRequests=\(trace.count { $0.entry == "-> chat.history" })",
+            "historyAnswers=\(trace.count { $0.entry == "<- chat.history" })",
+        ].joined(separator: " "))
+        print(lines.joined(separator: "\n"))
+        // The simulator shares the host file system; the driver passes a host path.
+        if let path = ProcessInfo.processInfo.environment["RECONNECT_WIRE_OUT"] {
+            try lines.joined(separator: "\n").write(toFile: path, atomically: true, encoding: .utf8)
+        }
+        #expect(connections.count >= 2)
+        #expect(trace.contains { $0.entry == "<- chat.history" })
+        // Back-to-back reconnects must not stack catalog bursts ahead of the transcript.
+        #expect(mostRepeatedEarlyRead <= 1, "a catalog was re-read before any transcript answer")
+    }
+}
