@@ -0,0 +1,58 @@
+#if os(macOS) || os(iOS)
+import Foundation
+import OpenClawChatUI
+import Testing
+@testable import OpenClawKit
+
+/// Proof-only, not part of the fix: sends one 8 MB file through the shipped request path
+/// (GatewayNodeSession.request, real URLSession WebSocket) to a Gateway fixture that reads
+/// the upload at 160 KiB/s and ACKs chat.send only after the whole frame arrives (~65 s).
+struct ChatSendSlowUploadProofTests {
+    @Test(.stateDirectoryIsolated)
+    func `chat send with an 8 MB file is acknowledged after a slow upload`() async throws {
+        let rate = 160 * 1024
+        let fixture = try await NativeGatewayWebSocketFixture.start(issuedDeviceTokens: [nil])
+        defer { fixture.stop() }
+        fixture.throttleUploads(bytesPerSecond: rate)
+        let gateway = GatewayNodeSession()
+        try await gateway.connect(
+            url: fixture.url(),
+            credentials: .init(),
+            connectOptions: GatewayConnectOptions(
+                role: "node", scopes: [], caps: [], commands: [], permissions: [:],
+                clientId: "slow-upload-proof", clientMode: "node", clientDisplayName: "Slow Upload Proof",
+                includeDeviceIdentity: false),
+            sessionBox: nil,
+            onConnected: {},
+            onDisconnected: { _ in },
+            onInvoke: { BridgeInvokeResponse(id: $0.id, ok: true) })
+
+        let content = Data(repeating: 0x41, count: 8_000_000).base64EncodedString()
+        let request = OpenClawChatGatewayRequests.sendMessage(
+            sessionKey: "main",
+            agentID: nil,
+            expectedSessionRoutingContract: nil,
+            message: "report",
+            thinking: nil,
+            idempotencyKey: "slow-upload-proof",
+            attachments: [.init(type: "file", mimeType: "application/pdf", fileName: "report.pdf", content: content)])
+        let readBefore = fixture.bytesRead(at: 0)
+        let started = ContinuousClock.now
+        let outcome: String
+        do {
+            let data = try await gateway.request(request)
+            let ack = try JSONDecoder().decode(OpenClawChatSendResponse.self, from: data)
+            outcome = "ack runId=\(ack.runId) status=\(ack.status)"
+        } catch {
+            outcome = "error=\(error.localizedDescription)"
+        }
+        let elapsed = ContinuousClock.now - started
+        let read = fixture.bytesRead(at: 0) - readBefore
+        print(
+            "SEND_TIMEOUT_PROOF deadlineMs=\(Int(request.timeoutMs)) attachmentBase64Bytes=\(content.utf8.count)",
+            "drainBytesPerSecond=\(rate) elapsed=\(elapsed) serverReadBytesAtOutcome=\(read) outcome=\(outcome)")
+        await gateway.disconnect()
+        #expect(outcome == "ack runId=proof-run status=started")
+    }
+}
+#endif
