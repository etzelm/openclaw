+                    // Accepted rows await history confirmation or are already gone.
+                    return tracked.contains { $0.status == .failed } ? .failed : .delivered
+                }
+            }
+            try? await Task.sleep(nanoseconds: 100_000_000)
+        }
+        return .pending
+    }
