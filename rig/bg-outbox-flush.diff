+    /// Background wakes report completion as soon as their own work ends, and
+    /// the OS may suspend the app right after. Give queued sends a bounded
+    /// window to flush first. Returns false when work remains at the deadline.
+    public func drainOutboxForBackgroundWake(timeoutMs: Int) async -> Bool {
+        guard let outbox, !self.isTransportDetached else { return true }
+        let deadline = Date().addingTimeInterval(Double(max(0, timeoutMs)) / 1000)
+        var forceHealthPoll = true
+        while !Task.isCancelled {
+            if self.outboxFlushTask == nil {
+                guard let commands = await outbox.loadCommandsIfAvailable() else { return false }
+                // Unconfirmed rows never replay automatically, so they do not hold the wake open.
+                guard commands.contains(where: { $0.status == .queued || $0.status == .sending }) else {
+                    return true
+                }
+                if self.healthOK {
+                    self.flushOutboxIfNeeded()
+                } else {
+                    // The wake may reconnect before its health event lands; ask once, then throttle.
+                    await self.pollHealthIfNeeded(force: forceHealthPoll)
+                    forceHealthPoll = false
+                }
+            }
+            guard Date() < deadline else { return false }
+            try? await Task.sleep(nanoseconds: 100_000_000)
+        }
+        return false
+    }
